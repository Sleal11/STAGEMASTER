# Dependencias: se instalan con "npm install" (versiones exactas en package-lock.json)
node_modules/

# Partido guardado por el servidor (data/match.json): es propio de cada PC
data/

# Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
*.log

# Ejecutables generados (StageMaster.exe)
dist/
build-info.json

# Capturas y datos temporales de las pruebas de navegador
tests/e2e/out/

# Vídeos explicativos: capturas y hojas de revisión (se regeneran con marketing/tutoriales/fuente/)
marketing/tutoriales/fuente/capturas/
marketing/tutoriales/revisar-*.png

# Vídeo de presentación: capturas y hojas de revisión (se regeneran con marketing/presentacion/fuente/)
marketing/presentacion/fuente/capturas/
marketing/presentacion/fuente/audio/
marketing/presentacion/revisar-*.png
