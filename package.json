{
  "name": "stagemaster",
  "version": "2.5.0",
  "description": "Marcador profesional de pádel para eventos: 2 partidos, hasta 8 pantallas (LED y monitores, también en portátiles remotos), publicidad y vídeos, historial, teléfonos de árbitro",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "app": "electron .",
    "test": "node server/sports/padel/engine.test.js && node server/core/core.test.js && node desktop/monitors.test.js && node server/integration.test.js",
    "test:engine": "node server/sports/padel/engine.test.js",
    "test:server": "node server/core/core.test.js",
    "test:desktop": "node desktop/monitors.test.js",
    "test:integration": "node server/integration.test.js",
    "test:e2e": "node tests/e2e/run-all.js",
    "simulate": "node tools/simulate-match.js",
    "dist:win": "electron-builder --win portable --x64 --publish never"
  },
  "author": "StageMaster",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "engines": {
    "node": ">=18"
  },
  "productName": "StageMaster",
  "build": {
    "appId": "com.stagemaster.score",
    "productName": "StageMaster",
    "copyright": "StageMaster",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "build-info.json",
      "desktop/**",
      "server/**",
      "public/**",
      "publicidad/**",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "StageMaster-${version}.exe"
    }
  }
}
